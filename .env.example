# Infrastructure settings for ice/devpod.sh. Copy to .env (git-ignored) and fill in.
KUBE_CONTEXT=my-cluster
KUBE_NAMESPACE=my-namespace
DEVPOD_NAME=tacscm-dev
DEVPOD_IMAGE=ghcr.io/<owner>/<repo>-devcontainer:latest
DEVPOD_PULL_SECRET=my-registry-pull-secret
# An existing ReadWriteOnce volume claim; the repo is cloned into DEVPOD_SUBPATH on it.
DEVPOD_PVC=my-volume-claim
DEVPOD_SUBPATH=tacscm-challenge
DEVPOD_REPO_URL=https://github.com/<owner>/<repo>.git
DEVPOD_CPU=16
DEVPOD_MEMORY=64Gi
